# SQLite is used by default. Uncomment this to use SQL Server instead.
# Install Microsoft ODBC Driver 18 for SQL Server and URL-encode special
# characters in the username or password.
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@SERVER/DATABASE?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
